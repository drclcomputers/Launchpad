    "Drag an app onto another to make a folder. Drop it on the side of an app to reorder. Right-click to hide an app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehe eine App auf eine andere, um einen Ordner zu erstellen. Lege sie seitlich an eine App ab, um die Reihenfolge zu ändern. Rechtsklick, um eine App auszublenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag an app onto another to make a folder. Drop it on the side of an app to reorder. Right-click to hide an app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra una app sobre otra para crear una carpeta. Suéltala al lado de una app para reordenar. Clic derecho para ocultar una app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser une app sur une autre pour créer un dossier. Déposez-la sur le côté d’une app pour réorganiser. Clic droit pour masquer une app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina un’app su un’altra per creare una cartella. Rilasciala sul lato di un’app per riordinare. Clic destro per nascondere un’app."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep een app op een andere om een map te maken. Zet hem naast een app neer om de volgorde te wijzigen. Rechtermuisklik om een app te verbergen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste uma app para cima de outra para criar uma pasta. Solte-a ao lado de uma app para reordenar. Clique com o botão direito para ocultar uma app."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage o aplicație peste alta pentru a crea un dosar. Las-o pe laterala unei aplicații pentru a reordona. Clic dreapta pentru a ascunde o aplicație."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを別のアプリの上にドラッグしてフォルダを作成します。アプリの横にドロップして並べ替えます。右クリックでアプリを非表示にします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将一个应用拖到另一个应用上即可创建文件夹。拖到应用侧面可重新排序。右键单击可隐藏应用。"
          }
        }
      }
    },
