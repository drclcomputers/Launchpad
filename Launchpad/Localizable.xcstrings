    "Launchpad keeps running in the background. Use the menu bar icon to open or quit it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Launchpad läuft im Hintergrund weiter. Nutze das Menüleistensymbol, um es zu öffnen oder zu beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Launchpad keeps running in the background. Use the menu bar icon to open or quit it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Launchpad sigue ejecutándose en segundo plano. Usa el icono de la barra de menús para abrirlo o salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Launchpad continue de s’exécuter en arrière-plan. Utilisez l’icône de la barre des menus pour l’ouvrir ou le quitter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Launchpad continua a funzionare in background. Usa l’icona nella barra dei menu per aprirlo o chiuderlo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Launchpad blijft op de achtergrond actief. Gebruik het menubalkpictogram om het te openen of te stoppen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Launchpad continua a ser executado em segundo plano. Utilize o ícone da barra de menus para o abrir ou sair."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Launchpad rulează în continuare în fundal. Folosește pictograma din bara de meniu pentru a-l deschide sau închide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Launchpadはバックグラウンドで動作し続けます。メニューバーのアイコンを使って開いたり終了したりできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Launchpad 会在后台继续运行。使用菜单栏图标打开或退出。"
          }
        }
      }
    },
