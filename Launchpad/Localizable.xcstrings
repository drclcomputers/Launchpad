    "All your apps in one place. Click an app to open it, or just start typing to search. Return opens the best match.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle deine Apps an einem Ort. Klicke auf eine App, um sie zu öffnen, oder tippe einfach, um zu suchen. Return öffnet den besten Treffer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your apps in one place. Click an app to open it, or just start typing to search. Return opens the best match."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas tus apps en un solo lugar. Haz clic en una app para abrirla, o empieza a escribir para buscar. Retorno abre la mejor coincidencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes vos apps au même endroit. Cliquez sur une app pour l’ouvrir, ou commencez simplement à taper pour rechercher. Retour ouvre la meilleure correspondance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le tue app in un unico posto. Fai clic su un’app per aprirla, oppure inizia a digitare per cercare. Invio apre la corrispondenza migliore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al je apps op één plek. Klik op een app om deze te openen, of begin gewoon te typen om te zoeken. Return opent de beste match."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as suas apps num só lugar. Clique numa app para a abrir, ou comece a escrever para pesquisar. Return abre a melhor correspondência."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toate aplicațiile tale într-un singur loc. Dă clic pe o aplicație pentru a o deschide, sau începe să tastezi pentru a căuta. Return deschide cea mai bună potrivire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのアプリをひとつの場所に。アプリをクリックして開くか、入力を始めて検索します。Returnキーで最適な一致を開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有应用集中在一处。点击应用即可打开，或直接开始输入进行搜索。按回车键打开最佳匹配项。"
          }
        }
      }
    },
    "Also turn off the Launchpad/Apps pinch in System Settings → Trackpad → More Gestures.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviere auch die Launchpad/Apps-Geste unter Systemeinstellungen → Trackpad → Weitere Gesten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also turn off the Launchpad/Apps pinch in System Settings → Trackpad → More Gestures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También desactiva el pellizco de Launchpad/Apps en Ajustes del sistema → Trackpad → Más gestos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez également le pincement Launchpad/Apps dans Réglages système → Trackpad → Autres gestes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva anche il pinch di Launchpad/App in Impostazioni di sistema → Trackpad → Altri gesti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel ook de Launchpad/Apps-pinch uit in Systeeminstellingen → Trackpad → Meer gebaren."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative também o pinça de Launchpad/Apps em Definições do Sistema → Trackpad → Mais Gestos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivează și gestul de ciupire Launchpad/Aplicații din Setări sistem → Trackpad → Mai multe gesturi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → トラックパッド → その他のジェスチャで、Launchpad/Appsのピンチもオフにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时在“系统设置 → 触控板 → 更多手势”中关闭 Launchpad/应用捏合手势。"
          }
        }
      }
    },
