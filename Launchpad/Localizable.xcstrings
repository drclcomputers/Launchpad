    "Launchpad keeps running in the background. Use the menu bar icon to open or quit it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launchpad läuft im Hintergrund weiter. Nutze das Menüleistensymbol, um es zu öffnen oder zu beenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launchpad keeps running in the background. Use the menu bar icon to open or quit it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launchpad sigue ejecutándose en segundo plano. Usa el icono de la barra de menús para abrirlo o salir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launchpad continue de s’exécuter en arrière-plan. Utilisez l’icône de la barre des menus pour l’ouvrir ou le quitter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launchpad continua a funzionare in background. Usa l’icona nella barra dei menu per aprirlo o chiuderlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Launchpadはバックグラウンドで動作し続けます。メニューバーのアイコンを使って開いたり終了したりできます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
