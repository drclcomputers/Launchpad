    "Use the arrow keys to move around, Return to open, and the , and . keys to flip pages. Esc closes Launchpad.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende die Pfeiltasten zum Navigieren, Return zum Öffnen sowie die Tasten , und . zum Wechseln der Seiten. Esc schließt Launchpad."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the arrow keys to move around, Return to open, and the , and . keys to flip pages. Esc closes Launchpad."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa las teclas de flecha para moverte, Retorno para abrir, y las teclas , y . para cambiar de página. Esc cierra Launchpad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les flèches pour vous déplacer, Retour pour ouvrir, et les touches , et . pour changer de page. Échap ferme Launchpad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa i tasti freccia per spostarti, Invio per aprire e i tasti , e . per cambiare pagina. Esc chiude Launchpad."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de pijltjestoetsen om te navigeren, Return om te openen en de toetsen , en . om van pagina te wisselen. Esc sluit Launchpad."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilize as teclas de seta para se mover, Return para abrir e as teclas , e . para mudar de página. Esc fecha o Launchpad."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește tastele săgeată pentru a te deplasa, Return pentru a deschide și tastele , și . pentru a schimba paginile. Esc închide Launchpad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "矢印キーで移動し、Returnで開き、, と . キーでページをめくります。EscでLaunchpadを閉じます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用方向键移动，按回车键打开，使用 , 和 . 键翻页。按 Esc 关闭 Launchpad。"
          }
        }
      }
    },
