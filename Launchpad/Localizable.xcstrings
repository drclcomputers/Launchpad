    "This removes all folders and your custom order. Hidden apps stay hidden." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle Ordner und deine eigene Reihenfolge entfernt. Ausgeblendete Apps bleiben ausgeblendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This removes all folders and your custom order. Hidden apps stay hidden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina todas las carpetas y tu orden personalizado. Las apps ocultas seguirán ocultas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime tous les dossiers et votre ordre personnalisé. Les apps masquées restent masquées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo rimuove tutte le cartelle e l’ordine personalizzato. Le app nascoste restano nascoste."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのフォルダとカスタムの並び順が削除されます。非表示のアプリは非表示のままです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit verwijdert alle mappen en jouw aangepaste volgorde. Verborgen apps blijven verborgen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto remove todas as pastas e a sua ordem personalizada. As apps ocultas permanecem ocultas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceasta elimină toate dosarele și ordinea personalizată. Aplicațiile ascunse rămân ascunse."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将删除所有文件夹和您的自定义排序。已隐藏的应用仍保持隐藏。"
          }
        }
      }
    },
