    "Choose a shortcut to open and close Launchpad from any app. You can change it later in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Kurzbefehl, um Launchpad aus jeder App zu öffnen und zu schließen. Du kannst ihn später in den Einstellungen ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a shortcut to open and close Launchpad from any app. You can change it later in Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un atajo para abrir y cerrar Launchpad desde cualquier app. Puedes cambiarlo más tarde en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un raccourci pour ouvrir et fermer Launchpad depuis n’importe quelle app. Vous pourrez le modifier plus tard dans Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una scorciatoia per aprire e chiudere Launchpad da qualsiasi app. Puoi modificarla in seguito nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのアプリからでもLaunchpadを開閉できるショートカットを選択してください。後で設定で変更できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies een sneltoets om Launchpad vanuit elke app te openen en te sluiten. Je kunt deze later wijzigen in Instellingen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um atalho para abrir e fechar o Launchpad a partir de qualquer app. Pode alterá-lo mais tarde nas Definições."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alege o comandă rapidă pentru a deschide și închide Launchpad din orice aplicație. O poți schimba mai târziu în Setări."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一个快捷键，以便从任何应用中打开和关闭 Launchpad。稍后可在设置中更改。"
          }
        }
      }
    },
